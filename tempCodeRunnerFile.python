for _ in range(int(input())):
    n , k = map(int,input().split())
    s = input()
    count = 0 
    last = s[-1]
    i = n-1
    while (i>=0 and k>0):
        if s[i]=='1':
            i-=1
            last = '1'
            count+=1
            continue
        if last =='1' and s[i]=='0':
            count+=1
            k-=1
            last = '1'
            i-=1
        else:
            last = '0'
            i-=1
    print(count)